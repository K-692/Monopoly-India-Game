{
  "name": "indian-monopoly",
  "version": "1.1.0",
  "description": "Indian Monopoly — Real-time multiplayer board game with native desktop builds for macOS and Windows, LAN Wi-Fi hosting, and authoritative rules engine.",
  "author": "K-692",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/K-692/Monopoly-India-Game.git"
  },
  "keywords": [
    "monopoly",
    "board-game",
    "multiplayer",
    "lan-party",
    "electron",
    "react",
    "typescript",
    "socket-io",
    "tailwindcss"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --target=node20 --outfile=dist-server/index.cjs --external:express --external:socket.io --external:qrcode",
    "build:lan": "tsc -b && vite build --mode lan",
    "build:desktop": "node scripts/build-desktop.js",
    "desktop": "npm run build:desktop && electron .",
    "lan:host": "npm run build:lan && tsx server/index.ts",
    "lan:dev": "node scripts/lan-dev.js",
    "server": "tsx server/index.ts",
    "package:installers": "node scripts/package-installers.js",
    "pack": "npm run build:desktop && electron-builder --dir",
    "dist:mac": "npm run build:desktop && electron-builder --mac dmg",
    "dist:win": "npm run build:desktop && electron-builder --win nsis",
    "dist:all": "npm run build:desktop && electron-builder -mw",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.indianmonopoly.game",
    "productName": "Indian Monopoly",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "mac": {
      "artifactName": "Indian-Monopoly-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.board-games"
    },
    "win": {
      "artifactName": "Indian-Monopoly-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
