rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Game Rooms & Lobbies (accessible via room link/code)
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if false; // All room mutations via callable Functions

      match /members/{memberId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Live Authoritative Game State
    match /games/{gameId} {
      allow read: if true;
      allow write: if false; // Strictly server-authoritative

      match /events/{eventId} {
        allow read: if true;
        allow write: if false;
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // Completed Immutable Game Archives
    match /gameArchives/{archiveId} {
      allow read: if true;
      allow write: if false;
    }

    // Command Receipts (server internal audit)
    match /commandReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
