rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for user authentication
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Game Rooms & Lobbies
    // Authenticated users can read rooms to query by inviteCodeHash and subscribe
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if false; // All room mutations strictly via Cloud Functions

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Live Authoritative Game State
    match /games/{gameId} {
      allow read: if isAuthenticated();
      allow write: if false; // Strictly server-authoritative mutations via Cloud Functions

      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Completed Immutable Game Archives
    match /gameArchives/{archiveId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Command Receipts (server internal audit)
    match /commandReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
