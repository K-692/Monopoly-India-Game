# Indian Monopoly — Environment Variables Template
# Nothing here is required: the defaults work out of the box.

# ---------- LAN host (npm run lan:host) ----------
# Port the LAN server listens on (default: 4173)
PORT=4173
# Grace period (ms) before a CPU bot takes over a disconnected human player
BOT_TAKEOVER_GRACE_MS=10000

# ---------- Build ----------
# Base path for the built site ('/Monopoly-India-Game/' for GitHub Pages, '/' for LAN)
VITE_APP_BASE_PATH=/

# Force a network mode for local testing: 'online' (Supabase) or 'lan'.
# Leave empty to auto-detect (public hostnames such as GitHub Pages use online mode).
VITE_NETWORK_MODE=

# ---------- Online mode (Supabase) ----------
# Public project URL and publishable key. Both are safe to ship in the browser;
# defaults point at the game's Supabase project. NEVER put a database password,
# Postgres connection string or service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
