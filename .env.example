# Indian Monopoly — Environment Variables Template
# Server & Client Configuration

# Server Port (default: 4173)
PORT=4173

# Node Environment: 'production', 'development', or 'test'
NODE_ENV=production

# Render PostgreSQL Database Connection URL (Mandatory in production)
DATABASE_URL=postgresql://user:password@hostname:5432/monopoly_india

# Grace period in milliseconds before activating CPU bot takeover for a disconnected human player
BOT_TAKEOVER_GRACE_MS=10000

# Allowed client origin for CORS in production (e.g. your hosted app domain)
CLIENT_ORIGIN=https://monopoly-india-game.onrender.com

# Public Server URL for remote client connections (leave empty when served from same origin)
VITE_SERVER_URL=https://monopoly-india-game.onrender.com
VITE_APP_BASE_PATH=/
